{
  "name": "rat-radical-advanced-tools",
  "version": "1.1.0",
  "description": "RAT (Radical Advanced Tools) 1.1: upscaler, frame generation, HDR and shader suite for SteamOS and Linux (AMD, NVIDIA, Intel).",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "keywords": [
    "decky",
    "plugin",
    "steamos",
    "linux",
    "optiscaler",
    "dlss",
    "fsr",
    "xess",
    "upscaling",
    "frame-generation",
    "reshade",
    "renodx",
    "hdr"
  ],
  "author": "Tom Berczeller",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "5.3.0",
    "tslib": "2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
